<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0E0C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/logo"
            android:contentDescription="Dorset Jewellers" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gold Trader widget"
            android:textColor="#F0CB6A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.3"
            android:text="Add the widget to your home screen:\n\n1. Go to your home screen.\n2. Press and hold an empty space.\n3. Tap Widgets.\n4. Find Gold Trader, then press and drag it onto your screen.\n\nIt shows the live 24ct price and the sell call, and updates itself every 30 minutes. Tap ↻ on the widget to refresh now, or tap the widget to open the full app."
            android:textColor="#F3EFE6"
            android:textSize="16sp" />

        <Button
            android:id="@+id/open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="#D4A843"
            android:text="Open Gold Trader"
            android:textColor="#1A1408"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
